{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gomod",
    "helpers:pinGitHubActionDigests",
    "security:gomodIndirectSecurityUpdates"
  ],
  "timezone": "America/Chicago",
  "schedule": ["* * * * 1"],
  "updateNotScheduled": true,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "platformAutomerge": false,
  "gitIgnoredAuthors": [
    "230059765+slogcp-e2e-orchestrator[bot]@users.noreply.github.com"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "vulnerabilityFixStrategy": "lowest"
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidyAll"
  ],
  "packageRules": [
    {
      "description": "Do not automate slogcp's public Go compatibility floor",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "enabled": false
    },
    {
      "description": "Ignore local shared .e2e modules resolved via replace directives",
      "matchManagers": ["gomod"],
      "matchFileNames": [".e2e/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp-e2e-internal/**"],
      "enabled": false
    },
    {
      "description": "Ignore local slogcp module requirements in .e2e modules resolved via replace directives",
      "matchManagers": ["gomod"],
      "matchFileNames": [".e2e/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp"],
      "enabled": false
    },
    {
      "description": "GitHub Actions updates stay separate from executable CI tools",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/**"],
      "groupName": "github actions",
      "labels": ["renovate:type1"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 20
    },
    {
      "description": "1b. Compiler-sensitive Go CI tools update together and execute their changed binaries",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v2",
        "golang.org/x/tools",
        "golang.org/x/tools/gopls",
        "golang.org/x/vuln"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "enabled": true,
      "groupName": "compiler-sensitive ci tools",
      "labels": ["renovate:type1"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 25
    },
    {
      "description": "1c. Auxiliary Go CI tools stay independent of compiler-sensitive tools",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/apache/skywalking-eyes"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "enabled": true,
      "groupName": "auxiliary ci tools",
      "labels": ["renovate:type1"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 20
    },
    {
      "description": "Do not update the CI tools module Go directive independently",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".github/tools/go.mod"],
      "enabled": false
    },
    {
      "description": "Keep CI tools vulnerability fixes separate from public dependency floor updates",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion)"],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "additionalBranchPrefix": "ci-tools-",
      "addLabels": ["renovate:type1"]
    },
    {
      "description": "Do not propose routine root go.mod dependency floor updates",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$not(isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion))"],
      "matchDatasources": ["go"],
      "matchDepTypes": ["require", "indirect"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "pinDigest", "lockFileMaintenance", "rollback", "replacement"],
      "enabled": false
    },
    {
      "description": "Security floor updates must not wait for normal root Dependency Dashboard approval",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchDepTypes": ["require", "indirect"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion)"],
      "enabled": true,
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "additionalBranchPrefix": "root-security-",
      "bumpVersions": [
        {
          "filePatterns": ["version.go"],
          "matchStrings": ["(?:var|const) Version = \"v(?<version>\\d+\\.\\d+\\.\\d+)\""],
          "bumpType": "patch"
        }
      ],
      "addLabels": ["security:floor", "renovate:type-security-floor"]
    },
    {
      "description": "Keep the root go.mod toolchain directive on the latest released Go toolchain without E2E or release",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["toolchain"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "groupName": "root go toolchain",
      "labels": ["renovate:toolchain", "dependency-scope:toolchain"],
      "prPriority": 15
    },
    {
      "description": "Keep checked-in example module go directives on the latest released Go version",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".examples/**/go.mod"],
      "rangeStrategy": "bump",
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "groupName": "examples go directives",
      "labels": ["renovate:examples", "dependency-scope:examples", "renovate:go-version"],
      "prPriority": 6
    },
    {
      "description": "Keep direct and indirect example dependencies on latest compatible versions",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchFileNames": [".examples/**/go.mod"],
      "enabled": true,
      "groupName": "examples module dependencies",
      "labels": ["renovate:examples", "dependency-scope:examples"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 5
    },
    {
      "description": "Keep example security repairs separate from root and tooling repairs",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchFileNames": [".examples/**/go.mod"],
      "matchJsonata": ["isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion)"],
      "additionalBranchPrefix": "examples-"
    },
    {
      "description": "Automerge Docker dependencies used by e2e tests after validation",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".e2e/**"],
      "groupName": "e2e docker dependencies",
      "labels": ["renovate:e2e", "dependency-scope:e2e"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 5
    },
    {
      "description": "Do not update the local unpublished slogcp requirement used by examples",
      "matchManagers": ["gomod"],
      "matchFileNames": [".examples/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp"],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10
}
