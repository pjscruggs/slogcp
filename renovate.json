{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:semverAllWeekly",
    ":gomod",
    ":noUnscheduledUpdates",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Chicago",
  "platformAutomerge": true,
  "gitIgnoredAuthors": [
    "230059765+slogcp-e2e-orchestrator[bot]@users.noreply.github.com"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "security:floor", "renovate:type-security-floor"],
    "vulnerabilityFixStrategy": "lowest",
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Do not automate slogcp's public Go compatibility floor",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "enabled": false
    },
    {
      "description": "Ignore local shared .e2e modules resolved via replace directives",
      "matchManagers": ["gomod"],
      "matchFileNames": [".e2e/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp-e2e-internal/**"],
      "enabled": false
    },
    {
      "description": "Ignore local slogcp module requirements in .e2e modules resolved via replace directives",
      "matchManagers": ["gomod"],
      "matchFileNames": [".e2e/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp"],
      "enabled": false
    },
    {
      "description": "1a. GitHub Actions updates run earlier and stay separate from executable CI tools",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/**"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "github actions",
      "labels": ["renovate:type1"],
      "schedule": ["* 2 * * *"],
      "prPriority": 20
    },
    {
      "description": "1b. Compiler-sensitive Go CI tools update together and execute their changed binaries",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v2",
        "golang.org/x/tools",
        "golang.org/x/tools/gopls",
        "golang.org/x/vuln"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "compiler-sensitive ci tools",
      "labels": ["renovate:type1"],
      "schedule": ["* 2 * * *"],
      "prPriority": 25
    },
    {
      "description": "1c. Auxiliary Go CI tools stay independent of compiler-sensitive tools",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/apache/skywalking-eyes"
      ],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "auxiliary ci tools",
      "labels": ["renovate:type1"],
      "schedule": ["* 2 * * *"],
      "prPriority": 20
    },
    {
      "description": "Do not update the CI tools module Go directive independently",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "enabled": false
    },
    {
      "description": "2. Go module updates run later and require local validation before cloud E2E",
      "matchManagers": ["gomod"],
      "matchFileNames": ["**/go.mod", "!.github/tools/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "labels": ["renovate:type2"],
      "schedule": ["* 4 * * *"],
      "prPriority": 10
    },
    {
      "description": "Do not propose routine root go.mod dependency floor updates",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "matchDatasources": ["go"],
      "matchDepTypes": ["require"],
      "enabled": false
    },
    {
      "description": "Security floor updates must not wait for normal root Dependency Dashboard approval",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$exists(vulnerabilityFixVersion)"],
      "enabled": true,
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["security", "security:floor", "renovate:type-security-floor"]
    },
    {
      "description": "Keep the root go.mod toolchain directive on the latest released Go toolchain without E2E or release",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["toolchain"],
      "matchDepNames": ["go"],
      "matchFileNames": ["go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "groupName": "root go toolchain",
      "labels": ["renovate:toolchain", "dependency-scope:toolchain"],
      "prPriority": 15
    },
    {
      "description": "Keep checked-in example module go directives on the latest released Go version",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "matchDepNames": ["go"],
      "matchFileNames": [".examples/**/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "rangeStrategy": "bump",
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr",
      "groupName": "examples go directives",
      "labels": ["renovate:examples", "dependency-scope:examples", "renovate:go-version"],
      "prPriority": 6
    },
    {
      "description": "Routine latest-compatible updates for checked-in example modules",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchFileNames": [".examples/**/go.mod"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "examples module dependencies",
      "labels": ["renovate:examples", "dependency-scope:examples"],
      "schedule": ["* 3-6 * * *"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 5
    },
    {
      "description": "Automerge Docker dependencies used by e2e tests after validation",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".e2e/**"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "groupName": "e2e docker dependencies",
      "labels": ["renovate:e2e", "dependency-scope:e2e"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "prPriority": 5
    },
    {
      "description": "Do not update the local unpublished slogcp requirement used by examples",
      "matchManagers": ["gomod"],
      "matchFileNames": [".examples/**"],
      "matchPackageNames": ["github.com/pjscruggs/slogcp"],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10
}
